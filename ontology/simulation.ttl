    rdfs:subClassOf emmo:EMMO_27c5d8c6_8af7_4d63_beb1_ec37cd8b3fa3 ;
    skos:definition "An energy expression of an atomistic spin model, written as a sum of terms over the magnetic moments localised on atomic sites."@en .

commagmo:MicromagneticEnergyTerms a owl:Class ;
    rdfs:label "MicromagneticEnergyTerms"@en ;
    rdfs:subClassOf emmo:EMMO_27c5d8c6_8af7_4d63_beb1_ec37cd8b3fa3 ;
    skos:definition "A set of energy contributions - exchange, anisotropy, demagnetising and Zeeman - whose sum a micromagnetic model minimises or evolves."@en .

commagmo:FreeEnergyFunctional a owl:Class ;
    rdfs:label "FreeEnergyFunctional"@en ;
    rdfs:subClassOf emmo:EMMO_27c5d8c6_8af7_4d63_beb1_ec37cd8b3fa3 ;
    skos:definition "A functional of one or more order parameters whose variational derivative drives the evolution equations of a phase field model."@en .

commagmo:CoreElectronTreatment a owl:Class ;
    rdfs:label "CoreElectronTreatment"@en ;
    rdfs:subClassOf emmo:EMMO_27c5d8c6_8af7_4d63_beb1_ec37cd8b3fa3 ;
    skos:definition "The part of a density functional theory model that states how the core electrons and the nuclear potential are represented in the Kohn-Sham Hamiltonian, either explicitly for all electrons or through an effective potential replacing the core region."@en .

commagmo:CorrectiveTerm a owl:Class ;
    rdfs:label "CorrectiveTerm"@en ;
    rdfs:subClassOf emmo:EMMO_27c5d8c6_8af7_4d63_beb1_ec37cd8b3fa3 ;
    skos:definition "An additional term added to the energy expression of a density functional theory model in order to repair a known deficiency of the chosen exchange correlation functional, such as the underestimated on-site Coulomb repulsion of localised states or the absence of long range dispersion."@en .

