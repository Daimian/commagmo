    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty commagmo:hasModelParameter ; owl:someValuesFrom commagmo:ModelParameter ] ;
    skos:definition "An atomistic model whose physics equation describes the behaviour of the magnetic moments localised on atomic sites."@en .

commagmo:MicromagneticModel a owl:Class ;
