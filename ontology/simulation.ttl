    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty commagmo:hasModelParameter ; owl:someValuesFrom commagmo:ModelParameter ] ;
    skos:definition "An electronic model whose physics equation determines the ground state of a many-electron system from functionals of the spatially dependent electron density."@en .

commagmo:AtomisticSpinModel a owl:Class ;
