    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty commagmo:hasModelParameter ; owl:someValuesFrom commagmo:ModelParameter ] ;
    skos:definition "A mesoscopic model whose physics equation describes the magnetisation as a continuous vector field over discretisation cells, each cell being treated as internally uniform."@en .

commagmo:PhaseFieldModel a owl:Class ;
