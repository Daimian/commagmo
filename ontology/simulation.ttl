commagmo:SimulationSetting a owl:Class ;
    rdfs:label "SimulationSetting"@en ;
    rdfs:subClassOf emmo:EMMO_eaf4640d_651d_4cbe_a315_3d2dc5df3b35 ;
    skos:definition "Procedural data that configures how a simulation run is carried out. Diagnostic: it never enters any equation, and it is fixed by whoever sets up the run rather than by the physics — typically it either has a convergence limit or is purely technical."@en .

commagmo:ModelParameter a owl:Class ;
    rdfs:label "ModelParameter"@en ;
    rdfs:subClassOf emmo:EMMO_d1d436e7_72fc_49cd_863b_7bfb4ba5276a ;
    skos:definition "A parameter appearing in the physics equation of a materials model, whose value is known independently of the equation. Diagnostic: it carries a physical dimension, has a provenance, and has no convergence limit."@en .

commagmo:MaterialSimulationSoftware a owl:Class ;
    rdfs:label "MaterialSimulationSoftware"@en ;
    rdfs:subClassOf emmo:EMMO_8b66ada5_510c_44bd_a8d8_3c64d301a5e9 ;
