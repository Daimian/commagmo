    skos:definition "A modelled property whose value is obtained from a simulation."@en .

commagmo:Discretisation a owl:Class ;
    rdfs:label "Discretisation"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that specifies how the continuous problem is sampled onto a finite set of points, cells or entities."@en .

commagmo:KPointMesh a owl:Class ;
    rdfs:label "KPointMesh"@en ;
    rdfs:subClassOf commagmo:Discretisation ;
    skos:definition "A discretisation that samples reciprocal space on a grid of k points."@en .

commagmo:AtomicConfiguration a owl:Class ;
    rdfs:label "AtomicConfiguration"@en ;
    rdfs:subClassOf commagmo:Discretisation ;
    skos:definition "A discretisation given by the set of atomic sites themselves, as used by atomistic models where no further mesh is introduced."@en .

commagmo:FiniteDifferenceGrid a owl:Class ;
    rdfs:label "FiniteDifferenceGrid"@en ;
    rdfs:subClassOf commagmo:Discretisation ;
    skos:definition "A discretisation that divides real space into regular cells on which finite differences are evaluated."@en .

commagmo:FiniteElementMesh a owl:Class ;
    rdfs:label "FiniteElementMesh"@en ;
    rdfs:subClassOf commagmo:Discretisation ;
    skos:definition "A discretisation that divides real space into irregular elements on which basis functions are defined."@en .

commagmo:BasisSet a owl:Class ;
    rdfs:label "BasisSet"@en ;
    rdfs:subClassOf commagmo:Discretisation ;
    skos:definition "A discretisation that fixes the finite set of functions in which the single particle wavefunctions are expanded, together with the cutoff that limits how many of them are kept."@en .

commagmo:SolverForDFT a owl:Class ;
    rdfs:label "SolverForDFT"@en ;
    rdfs:subClassOf commagmo:Solver ;
    skos:definition "A solver that numerically finds the self-consistent solution of the Kohn-Sham equations."@en .

commagmo:SolverForAtomisticSpin a owl:Class ;
    rdfs:label "SolverForAtomisticSpin"@en ;
    rdfs:subClassOf commagmo:Solver ;
    skos:definition "A solver that numerically evolves or samples a system of localised atomic magnetic moments, for example by Langevin dynamics or Monte Carlo."@en .

commagmo:SolverForMicromagnetics a owl:Class ;
    rdfs:label "SolverForMicromagnetics"@en ;
    rdfs:subClassOf commagmo:Solver ;
    skos:definition "A solver that numerically integrates the Landau-Lifshitz-Gilbert equation over a discretised magnetisation field."@en .

commagmo:SolverForPhaseField a owl:Class ;
    rdfs:label "SolverForPhaseField"@en ;
    rdfs:subClassOf commagmo:Solver ;
    skos:definition "A solver that numerically integrates the evolution equations of one or more continuous order parameters."@en .

commagmo:InitialCondition a owl:Class ;
    rdfs:label "InitialCondition"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that fixes the state of the discretised system before the solver starts."@en .

commagmo:InitialChargeDensity a owl:Class ;
    rdfs:label "InitialChargeDensity"@en ;
    rdfs:subClassOf commagmo:InitialCondition ;
    skos:definition "An initial condition that fixes the electron density from which the self-consistent cycle starts."@en .

commagmo:InitialSpinConfiguration a owl:Class ;
    rdfs:label "InitialSpinConfiguration"@en ;
    rdfs:subClassOf commagmo:InitialCondition ;
    skos:definition "An initial condition that fixes the orientation of every atomic magnetic moment before the run starts."@en .

commagmo:InitialMagnetisationState a owl:Class ;
    rdfs:label "InitialMagnetisationState"@en ;
    rdfs:subClassOf commagmo:InitialCondition ;
    skos:definition "An initial condition that fixes the magnetisation vector field over the discretisation cells before the run starts."@en .

commagmo:InitialOrderParameterField a owl:Class ;
    rdfs:label "InitialOrderParameterField"@en ;
    rdfs:subClassOf commagmo:InitialCondition ;
    skos:definition "An initial condition that fixes the value of every order parameter over the domain before the run starts."@en .

commagmo:BoundaryCondition a owl:Class ;
    rdfs:label "BoundaryCondition"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that fixes how the discretised domain behaves at its boundary."@en .

commagmo:PeriodicBoundaryCondition a owl:Class ;
    rdfs:label "PeriodicBoundaryCondition"@en ;
    rdfs:subClassOf commagmo:BoundaryCondition ;
    skos:definition "A boundary condition in which the domain repeats itself, so that a quantity leaving one face re-enters at the opposite one."@en .

commagmo:DirichletBoundaryCondition a owl:Class ;
    rdfs:label "DirichletBoundaryCondition"@en ;
    rdfs:subClassOf commagmo:BoundaryCondition ;
    skos:definition "A boundary condition that fixes the value of the field on the boundary."@en .

commagmo:NeumannBoundaryCondition a owl:Class ;
    rdfs:label "NeumannBoundaryCondition"@en ;
    rdfs:subClassOf commagmo:BoundaryCondition ;
    skos:definition "A boundary condition that fixes the normal derivative of the field on the boundary."@en .

commagmo:OpenBoundaryCondition a owl:Class ;
    rdfs:label "OpenBoundaryCondition"@en ;
    rdfs:subClassOf commagmo:BoundaryCondition ;
    skos:definition "A boundary condition in which the domain is treated as isolated, with the field decaying towards infinity."@en .

commagmo:ConvergenceCriterion a owl:Class ;
    rdfs:label "ConvergenceCriterion"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that states the quantity and the threshold by which the solver decides that the run has converged."@en .

commagmo:RandomSeed a owl:Class ;
    rdfs:label "RandomSeed"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that fixes the starting state of the pseudo-random number generator, so that a stochastic run can be repeated exactly."@en .

commagmo:NumericalPrecision a owl:Class ;
    rdfs:label "NumericalPrecision"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that fixes the accuracy of the numerical machinery of the run - grid densities, projection scheme and the like - without changing the physics being solved."@en .

commagmo:MixingScheme a owl:Class ;
    rdfs:label "MixingScheme"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that states how the input and output densities of successive self consistent iterations are combined in order to reach the self consistent solution."@en .

commagmo:RelaxationFreedom a owl:Class ;
    rdfs:label "RelaxationFreedom"@en ;
    rdfs:subClassOf commagmo:SimulationSetting ;
    skos:definition "A simulation setting that states which degrees of freedom of the simulated structure are allowed to change during the run - none, the ionic positions only, or the cell shape or volume as well."@en .

commagmo:ExchangeCorrelationFunctional a owl:Class ;
