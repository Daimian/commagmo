commagmo:MagneticStructure a owl:Class ;
    rdfs:label "MagneticStructure"@en ;
    rdfs:subClassOf commagmo:CrystalStructure ;
    skos:definition "A crystallographic language construct that describes the ideal, periodic arrangement of magnetic moments on the crystallographic sites of a magnetically ordered phase."@en .

commagmo:MagneticDomain a owl:Class ;
    rdfs:label "MagneticDomain"@en ;
    rdfs:subClassOf commagmo:MicrostructureComponent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty emmo:EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6 ; owl:someValuesFrom commagmo:Phase ] ;
    skos:definition "A region of a magnetically ordered body throughout which the magnetisation direction is uniform."@en .

commagmo:TopologicalDefect a owl:Class ;
    rdfs:label "TopologicalDefect"@en ;
    rdfs:subClassOf commagmo:Defect ;
    skos:definition "A defect in an ordered medium that is topologically protected, classified by the homotopy group of the order-parameter space."@en ;
    rdfs:comment "SCOPE. Within this ontology the ordered medium of interest is a magnetically ordered one: the order parameter is the magnetisation direction field, its target manifold is the unit sphere, and the intended instances are the topological defects of magnetic order — skyrmions and antiskyrmions, magnetic bubbles, vortex and skyrmion lines, Bloch points and emergent monopoles, domain walls that separate topologically distinct states (such as 180° walls under uniaxial anisotropy), and hopfions. MagneticDomainWall itself is not a subclass: a 360° wall joins a state to itself and is topologically trivial. Lattice defects belong to the sibling class CrystallographicDefect instead."@en ;
    rdfs:comment "SCOPE IS EDITORIAL, NOT LOGICAL. The definition above is the general one and covers ordered media of any kind — liquid crystals, superfluids, superconductors — and no axiom on this class restricts it to magnetic systems. Nothing prevents a non-magnetic instance, and nothing here carries the topological criterion itself: neither an order-parameter field, nor a target manifold, nor a winding number is represented. Making the magnetic scope logical would require that machinery first."@en ;
    rdfs:comment "TOPOLOGICAL AND DIMENSIONAL ARE ORTHOGONAL CRITERIA OVER ONE POPULATION, NOT TWO TREES. This class is a sibling of CrystallographicDefect, not a fourth member of the PointDefect / LineDefect / PlaneDefect triad, which cuts by the dimension of the defect locus. A dislocation is both a LineDefect and a TopologicalDefect and should carry both parents; a vacancy is a PointDefect and is not topological; a skyrmion in a thin film is topological and its host lattice is perfect."@en .

commagmo:MagneticDomainWall a owl:Class ;
    rdfs:label "MagneticDomainWall"@en ;
    rdfs:subClassOf commagmo:Defect ;
    rdfs:subClassOf commagmo:MicrostructureComponent ;
    skos:definition "A two-dimensional region separating magnetic domains, across which the direction of the magnetisation rotates."@en .

commagmo:SpatialContrast a owl:Class ;
    rdfs:label "SpatialContrast"@en ;
    skos:altLabel "SpatialPattern"@en ;
    skos:altLabel "SpatialVariation"@en ;
    rdfs:subClassOf emmo:EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660 ;
    skos:definition "An entity with a spatial variation of its properties."@en .

commagmo:Defect a owl:Class ;
    rdfs:label "Defect"@en ;
    rdfs:subClassOf commagmo:SpatialContrast ;
    skos:definition "A local deviation from a regular pattern."@en .

commagmo:CrystallographicDefect a owl:Class ;
    rdfs:label "CrystallographicDefect"@en ;
    rdfs:subClassOf commagmo:Defect ;
    skos:definition "An imperfection in the regular geometrical arrangement of the atoms in a crystalline solid."@en .

commagmo:PointDefect a owl:Class ;
    rdfs:label "PointDefect"@en ;
    rdfs:subClassOf commagmo:CrystallographicDefect ;
    skos:definition "A crystalline defect which is localized at or around a single lattice point. It is considered to be a zero-dimensional defect because it does not extend in any dimension in the lattice."@en .

commagmo:Vacancy a owl:Class ;
    rdfs:label "Vacancy"@en ;
    rdfs:subClassOf commagmo:PointDefect ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/cdos/podo/Vacancy> ;
    skos:definition "A vacancy is a point defect in which an atom is missing from its original lattice site."@en ;
    dcterms:source "PODO"@en .

commagmo:Interstitial a owl:Class ;
    rdfs:label "Interstitial"@en ;
    rdfs:subClassOf commagmo:PointDefect ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/cdos/podo/Interstitial> ;
    skos:definition "An interstitial is a point defect where an atom occupies an interstitial site."@en ;
    dcterms:source "PODO"@en .

commagmo:Impurity a owl:Class ;
    rdfs:label "Impurity"@en ;
    rdfs:subClassOf commagmo:PointDefect ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/cdos/podo/Impurity> ;
    skos:definition "An impurity is a point defect where foreign atoms (of different type as the host atom) enter the crystal lattice."@en ;
    dcterms:source "PODO"@en .

commagmo:SubstitutionalImpurity a owl:Class ;
    rdfs:label "SubstitutionalImpurity"@en ;
    rdfs:subClassOf commagmo:Impurity ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/cdos/podo/SubstitutionalImpurity> ;
    skos:definition "A substitutional impurity is an impurity where an atom of different type replaces a host or matrix atom."@en ;
    dcterms:source "PODO"@en .

commagmo:LineDefect a owl:Class ;
    rdfs:label "LineDefect"@en ;
    rdfs:subClassOf commagmo:CrystallographicDefect ;
    skos:definition "A linear or one-dimensional defect around which some of the atoms are misaligned."@en .

commagmo:PlaneDefect a owl:Class ;
    rdfs:label "PlaneDefect"@en ;
    skos:altLabel "PlanarDefect"@en ;
    rdfs:subClassOf commagmo:CrystallographicDefect ;
    skos:definition "A defect of the crystal structure across a plane. It is considered to be a two-dimensional defect, such as an internal interface or the surface."@en .

commagmo:MicrostructureComponent a owl:Class ;
