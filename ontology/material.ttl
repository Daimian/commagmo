    skos:definition "The smallest unit cell that contains the same point group symmetries as the overall lattice."@en ;
    rdfs:comment "The conventional unit cell is the one that is referred to in International Tables for Crystallography vol. A."@en .

commagmo:PrimitiveUnitCell a owl:Class ;
    rdfs:label "PrimitiveUnitCell"@en ;
