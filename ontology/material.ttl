    skos:definition "A crystalline phase that is magnetically ordered, having atomic magnetic moments due to unpaired electrons."@en .

commagmo:MagneticMaterial a owl:Class ;
    rdfs:label "MagneticMaterial"@en ;
    rdfs:subClassOf emmo:EMMO_4207e895_8b83_4318_996a_72cfb32acd94 ;
