commagmo:Supercell a owl:Class ;
    rdfs:label "Supercell"@en ;
    rdfs:subClassOf commagmo:UnitCell ;
    skos:definition "A unit cell obtained by repeating a smaller unit cell an integer number of times along each of its lattice vectors, used as the periodic unit of a calculation."@en ;
